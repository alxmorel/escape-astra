const CORNER := [
	Vector3(0, 0, 0), Vector3(1, 0, 0), Vector3(1, 1, 0), Vector3(0, 1, 0),
	Vector3(0, 0, 1), Vector3(1, 0, 1), Vector3(1, 1, 1), Vector3(0, 1, 1),
]
const EDGE := [
	[0, 1], [1, 2], [2, 3], [3, 0],
	[4, 5], [5, 6], [6, 7], [7, 4],
	[0, 4], [1, 5], [2, 6], [3, 7],
]


static func polygonize(
	values: PackedFloat32Array,
	materials: PackedByteArray,
	stride: int,
	origin: Vector3,
	voxel: float,
	iso: float,
	cell_min: int,
	cell_count: int
) -> Dictionary:
	var positions := PackedVector3Array()
	var mats := PackedByteArray()
	var cell_max := cell_min + cell_count
	for z in range(cell_min, cell_max):
		for y in range(cell_min, cell_max):
			for x in range(cell_min, cell_max):
				var corner_d: Array[float] = [0, 0, 0, 0, 0, 0, 0, 0]
				var corner_m: Array[int] = [0, 0, 0, 0, 0, 0, 0, 0]
				var mask := 0
				for i in 8:
					var cx := x + int(CORNER[i].x)
					var cy := y + int(CORNER[i].y)
					var cz := z + int(CORNER[i].z)
					var index := cx + stride * (cy + stride * cz)
					corner_d[i] = values[index]
					corner_m[i] = int(materials[index])
					if values[index] < iso:
						mask |= 1 << i
				if mask == 0 or mask == 255:
					continue
				var edges: int = EDGE_TABLE[mask]
				if edges == 0:
					continue
				var vert: Array = []
				var vert_mat: Array = []
				vert.resize(12)
				vert_mat.resize(12)
				for e in 12:
					if edges & (1 << e) == 0:
						continue
					var a: int = int(EDGE[e][0])
					var b: int = int(EDGE[e][1])
					var pa := origin + Vector3(x + CORNER[a].x, y + CORNER[a].y, z + CORNER[a].z) * voxel
					var pb := origin + Vector3(x + CORNER[b].x, y + CORNER[b].y, z + CORNER[b].z) * voxel
					vert[e] = _interp(iso, pa, pb, corner_d[a], corner_d[b])
					vert_mat[e] = corner_m[a] if corner_d[a] > corner_d[b] else corner_m[b]
				var row := mask * 16
				var t := 0
				while t < 16:
					var e0: int = TRI_TABLE[row + t]
					if e0 < 0:
						break
					var e1: int = TRI_TABLE[row + t + 1]
					var e2: int = TRI_TABLE[row + t + 2]
					positions.append(vert[e0] as Vector3)
					positions.append(vert[e1] as Vector3)
					positions.append(vert[e2] as Vector3)
					mats.append(int(vert_mat[e0]))
					mats.append(int(vert_mat[e1]))
					mats.append(int(vert_mat[e2]))
					t += 3
	return {"positions": positions, "materials": mats}


static func _interp(iso: float, p1: Vector3, p2: Vector3, d1: float, d2: float) -> Vector3:
	var delta := d2 - d1
	if absf(delta) < 0.00001:
		return (p1 + p2) * 0.5
	return p1.lerp(p2, clampf((iso - d1) / delta, 0.0, 1.0))
